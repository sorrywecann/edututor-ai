# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false  # markdown uses two-space line breaks
max_line_length = 80

[Makefile]
indent_style = tab

[*.{json,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2
max_line_length = 100

[*.{bat,cmd}]
end_of_line = crlf
