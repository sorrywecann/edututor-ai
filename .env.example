# EduTutor.AI — Environment Variables
# Copy this file: cp .env.example .env
# Then add at least one LLM key. Everything else has working defaults.

# ═══════════════════════════════════════════════════════════
# LLM — pick ONE provider (openai is easiest to start)
# ═══════════════════════════════════════════════════════════

# Option 1: OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option 1b: OpenAI-compatible (OpenRouter, Together, etc.)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-your-key-here
# OPENAI_MODEL=qwen/qwen-3.6-plus

# Option 2: Anthropic — https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Option 3: Groq — https://console.groq.com/ (free tier, fastest)
# GROQ_API_KEY=gsk_your-key-here

# Option 4: Local Ollama — https://ollama.com (no API key, fully offline)
# Install: brew install ollama (Mac) | https://ollama.com/download (Windows/Linux)
# Then: ollama pull qwen2.5:7b  (4.7GB, best Slovak for 12GB+ RAM)
#   or: ollama pull gemma3:4b   (2.5GB, lighter, for 8GB RAM)
# NOTE: Ollama is auto-detected at startup — you can leave these commented out.
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Option 5: vLLM — for RTX 4090 / A100 (power/server tier)
# Install: pip install vllm && vllm serve Qwen/Qwen2.5-32B-Instruct-AWQ --port 8001
# VLLM_URL=http://localhost:8001/v1
# VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# Option 6: Qwen3-14B-sk — native Slovak LLM (14B, Apache 2.0)
# Best Slovak quality of any open-source model. Deploy via:
#   Local: ollama create qwen3-14b-sk -f Modelfile (see scripts/deploy_qwen3_vastai.sh)
#   Cloud: Vast.ai RTX 4090 → run scripts/deploy_qwen3_vastai.sh
# Then uncomment and set the URL to your instance:
# CUSTOM_LLM_QWEN3_URL=http://VASTAI_IP:11434/v1
# CUSTOM_LLM_QWEN3_KEY=ollama
# CUSTOM_LLM_QWEN3_MODEL=qwen3-14b-sk
# Or for local Ollama after ollama create:
# CUSTOM_LLM_QWEN3_URL=http://localhost:11434/v1
# CUSTOM_LLM_QWEN3_KEY=ollama
# CUSTOM_LLM_QWEN3_MODEL=qwen3-14b-sk

# ═══════════════════════════════════════════════════════════
# STT — Speech to Text
# The hardware onboarding modal auto-picks the best for your machine.
# ═══════════════════════════════════════════════════════════
# mlx-whisper-turbo      → Apple Silicon M1/M2/M3/M4 (fastest, ~500ms)
# faster-whisper-sk-small → Windows / Linux / Mac Intel (~1s, CPU)
# faster-whisper-large-v3 → Best accuracy, needs 4GB+ RAM
# groq-whisper            → Cloud, ~100ms, free tier (needs GROQ_API_KEY)
# STT_PROVIDER=   ← leave blank to auto-detect best model for your hardware

# ═══════════════════════════════════════════════════════════
# TTS — Text to Speech
# Edge TTS is free and works out of the box (no key needed).
# ═══════════════════════════════════════════════════════════
USE_EDGE_TTS=true
EDGE_TTS_VOICE=sk-SK-LukasNeural

# Azure Neural TTS (optional — best Slovak voice quality)
# Get key: portal.azure.com → Create "Speech" resource → free 5h/month
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=westeurope

# Google Cloud TTS (optional — Chirp3 HD voices)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ═══════════════════════════════════════════════════════════
# Database — SQLite by default, no setup needed
# Uncomment PostgreSQL for production
# ═══════════════════════════════════════════════════════════
DATABASE_URL=
# DATABASE_URL=postgresql+asyncpg://edututor:password@localhost:5432/edututor
# ═══════════════════════════════════════════════════════════
# RAG — ChromaDB embedded, no Docker needed
# ═══════════════════════════════════════════════════════════
VECTOR_DB_BACKEND=chroma
CHROMA_PERSIST_PATH=./data/chroma
RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP must match rag_config.py default (was 120 historically — code says 80, see Field constraint)
RAG_CHUNK_OVERLAP=80
RAG_TOP_K_RESULTS=5
# RAG_SIMILARITY_THRESHOLD must match rag_config.py default (was 0.35 historically — code says 0.65, see Field constraint)
RAG_SIMILARITY_THRESHOLD=0.65

# ═══════════════════════════════════════════════════════════
# App
# ═══════════════════════════════════════════════════════════
APP_ENV=development

# Frontend (NextAuth) — auth.ts evaluates NEXTAUTH_SECRET at build time
# when NODE_ENV=production and throws if missing. Without this set,
# `docker compose up --build` fails on the frontend build step. Defaults
# below match docker-compose's `${NEXTAUTH_SECRET:-...}` fallback.
#
# IMPORTANT: even for local dev, set a STABLE NEXTAUTH_SECRET here. If left
# unset, docker-compose falls back to a hardcoded default; if anyone later
# overrides it (export NEXTAUTH_SECRET=... before `docker compose up`), every
# previously-signed session JWT becomes undecryptable and users see the
# "logged in then logged out on click" symptom until they manually clear
# cookies. Generate once with: openssl rand -base64 32
#
# NEXTAUTH_SECRET=replace-with-a-real-random-32-byte-base64-string
# NEXTAUTH_URL=https://your-frontend-domain.example
# NODE_ENV=production   # set to 'development' for source-map friendly builds

# ─── Frontend NextAuth (REQUIRED for production build) ──────────
# Generate with: openssl rand -base64 32
# OR (Windows PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Maximum 256}))
# NEXTAUTH_SECRET=

# The URL where NextAuth callbacks land (must match deployment)
# NEXTAUTH_URL=http://localhost:3000

# Demo password for development (optional; falls back to 'edututor2026' in code)
# DEMO_PASSWORD=

# CORS — comma-separated origins; if unset, sensible localhost defaults
# (3000/3001/3002 + https://edututor.ai) are used. Production deployments
# must set this to their actual frontend origin(s).
# CORS_ORIGINS=https://your-domain.example,https://staging.example

# WebSocket /ws/avatar origin allow-list (UE5 Blueprint clients).
# Native clients (UE5 libwebsockets, mobile, CLI tools) usually send NO
# Origin header and are allowed through unconditionally — only browsers
# are subject to this check. Production browser deployments add their
# origin here. The list ADDS to the localhost defaults, never replaces.
# WS_ALLOWED_ORIGINS=https://your-domain.example
#
# Escape hatch: set WS_ALLOW_ALL_ORIGINS=1 to disable the check entirely.
# Useful when a UE5 build sends an unexpected Origin header in staging.
# Do NOT set this in production browser deployments.
# WS_ALLOW_ALL_ORIGINS=0
DEBUG=true
LOG_LEVEL=INFO

# Emotion detection backend: regex (fast, default) or bert (PB2 fine-tuned model)
EMOTION_BACKEND=regex

# ═══════════════════════════════════════════════════════════
# Skills (Phase 7)
# ═══════════════════════════════════════════════════════════
# When false (default), the WebSearchSkill is registered but every search/fetch
# call returns a fixed "disabled" message — safer for production deployments
# without egress network access. The SpacedRepetitionSkill is unaffected by
# this flag (it only touches the local SQLite flashcards table).
WEB_SEARCH_ENABLED=false

# ===========================================
# LIPSYNC (3-tier quality ladder)
# ===========================================
# "hybrid"        = best: ARKit when model available, text/word-boundary otherwise (default)
# "audio2lipsync" = forces ARKit-only — HuBERT + Transformer, 52 MetaHuman blendshapes
#                   (~5ms accuracy, +200-400ms inference latency per sentence on CPU,
#                    much faster on GPU/MPS). Auto-downloads ~1.2GB on first use.
# "text"          = lightweight: Slovak text→viseme (14 shapes) + Edge TTS WordBoundary
#                   word-anchoring when available. No model load. Use on CPU-constrained
#                   deployments or to silence the model load attempt.
LIPSYNC_PROVIDER=hybrid
# Override checkpoint path (default: models/audio2lipsync/best.pt)
# AUDIO2LIPSYNC_CHECKPOINT=/path/to/best.pt

# ═══════════════════════════════════════════════════════════
# Additional LLM providers
# ═══════════════════════════════════════════════════════════

# Azure OpenAI (enterprise tier)
# AZURE_LLM_API_KEY=
# AZURE_LLM_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_LLM_MODEL=gpt-4o

# ANTHROPIC_MODEL — Anthropic Claude model identifier
# Set your preferred Anthropic model
# ANTHROPIC_MODEL=claude-haiku-4-5

# Provider toggles — force local-only paths regardless of API key presence.
# Useful for offline deploys (Ollama + faster-whisper, no cloud egress).
# USE_LOCAL_LLM=false
# USE_LOCAL_STT=false

# ═══════════════════════════════════════════════════════════
# Storage
# ═══════════════════════════════════════════════════════════

# SQLite database path (default: ./data/edututor.db). Used unless
# DATABASE_URL above is set to a Postgres URL.
# SQLITE_PATH=./data/edututor.db

# Redis (optional — used for context cache, not required).
# REDIS_URL=redis://localhost:6379/0

# Weaviate (only when VECTOR_DB_BACKEND=weaviate)
# WEAVIATE_URL=http://localhost:8080

# ═══════════════════════════════════════════════════════════
# Identity (Phase 8a — anonymous-by-default)
# ═══════════════════════════════════════════════════════════

# A stable UUID for the legacy "shared" user. On first run the middleware
# persists a generated UUID to LEGACY_USER_ID_PATH and reads it back on
# subsequent boots. Setting LEGACY_USER_ID overrides the file.
# LEGACY_USER_ID=
# LEGACY_USER_ID_PATH=./data/legacy_user_id.txt

# ═══════════════════════════════════════════════════════════
# Memory (Phase 8b — cross-session per-user memory, in flight)
# ═══════════════════════════════════════════════════════════

# Persistence root for the per-user episodic memory Chroma collections.
# Defaults to ./data/memory.
# MEMORY_PERSIST_PATH=./data/memory

# ═══════════════════════════════════════════════════════════
# UE5 avatar bridge — timing
# ═══════════════════════════════════════════════════════════

# Compensates for the gap between TTS audio start (browser) and viseme
# timeline emit (server). 180ms is the calibrated default that matches
# the median MSE buffer fill in useVoiceSession.ts. Raise on slow networks
# or when running TTS on remote GPUs; lower (or set to 0) when running
# fully local with low-latency TTS (Edge / Piper).
# UE5_BROADCAST_DELAY_MS=180

# ═══════════════════════════════════════════════════════════
# Viseme timeline (text-path lipsync grid tuning)
# ═══════════════════════════════════════════════════════════
# All EDU_VISEME_* knobs in tutor-service/app/services/viseme_timeline.py.
# Defaults are calibrated for Slovak phoneme-to-viseme mapping. Override
# only when re-tuning for non-Slovak languages or specific TTS latencies.
# EDU_VISEME_FRAME_STEP_MS=80      # dense grid spacing (clamped 4..200)
# EDU_VISEME_RAMP_MS=80            # coarticulation ramp (defaults to FRAME_STEP_MS)
# EDU_VISEME_SHORT_VOWEL_MS=60     # duration of short vowels (a, e, i, o, u)
# EDU_VISEME_LONG_VOWEL_MS=100     # duration of long vowels (á, é, í, ó, ú)
# EDU_VISEME_CONSONANT_MS=45       # duration of consonants

# ═══════════════════════════════════════════════════════════
# Custom LLM providers — dynamic dispatch (any name)
# ═══════════════════════════════════════════════════════════
# Optional: scripts/deploy_qwen3_vastai.sh helper for self-hosted Qwen3 on vast.ai GPU rental. Not required for local dev.
# Define ANY custom OpenAI-compatible endpoint via the pattern:
#   CUSTOM_LLM_<NAME>_URL    = http://endpoint/v1
#   CUSTOM_LLM_<NAME>_KEY    = optional bearer token
#   CUSTOM_LLM_<NAME>_MODEL  = model identifier sent to the endpoint
# The provider auto-registers under "<NAME>" (lowercased) at startup
# and is selectable via POST /api/v1/llm/switch. Used in production for
# Qwen3-14b-sk on vast.ai (CUSTOM_LLM_QWEN3_URL, _KEY, _MODEL).
# CUSTOM_LLM_QWEN3_URL=http://vast-instance:11434/v1
# CUSTOM_LLM_QWEN3_KEY=ollama
# CUSTOM_LLM_QWEN3_MODEL=qwen3-14b-sk

# Multiple custom providers can coexist:
# CUSTOM_LLM_LOCAL_URL=http://localhost:11434/v1
# CUSTOM_LLM_LOCAL_KEY=ollama
# CUSTOM_LLM_LOCAL_MODEL=qwen2.5:14b

# DEPRECATED — Coqui TTS provider was removed. Section kept for migration reference; safe to delete.
# ═══════════════════════════════════════════════════════════
# Legacy / removed providers (kept for back-compat; not used in v5.0)
# ═══════════════════════════════════════════════════════════
# Coqui TTS used XTTS-v2 (removed in v5.0 in favour of OmniVoice). The TOS
# accept flag is still read by tts_service.py guard branch — set when
# experimenting with legacy Coqui paths only.
# COQUI_TOS_AGREED=0

# ═══════════════════════════════════════════════════════════
# Dev mode — gates the /api/v1/avatar/dev/broadcast injector
# ═══════════════════════════════════════════════════════════

# Set to 1/true/yes to enable the Inject panel at /avatar-debug, which
# lets the Blueprint dev push synthetic avatar commands through the
# WebSocket without a live chat. Production deployments leave this off
# (the endpoint returns 404 when disabled).
# EDU_DEV_MODE=0

# ═══════════════════════════════════════════════════════════
# Optional service-level API key (gateway auth)
# ═══════════════════════════════════════════════════════════

# If set, the backend rejects requests without a matching `X-EduTutor-API-Key`
# header. Use behind a reverse proxy that already authenticates users.
# EDUTUTOR_API_KEY=

# ═══════════════════════════════════════════════════════════
# LiveKit worker (optional — separate agent_worker.py process)
# ═══════════════════════════════════════════════════════════

# Only required when running the dedicated LiveKit agent worker
# (`python -m app.agent_worker`). The Next.js frontend uses LiveKit via
# its own NEXT_PUBLIC_* envs in core/.env.local.
# LIVEKIT_URL=wss://your-livekit-instance.example
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ═══════════════════════════════════════════════════════════
# TTS — OmniVoice voice cloning (replaced XTTS-v2 + Chatterbox)
# ═══════════════════════════════════════════════════════════

# OmniVoice (k2-fsa/OmniVoice) — state-of-the-art voice cloning TTS,
# 600+ languages incl. Slovak. ~1.2GB model auto-downloads on first use.
# Default language for voice clones. Switch per request via API.
# OMNIVOICE_LANGUAGE=sk

# ─── Optional runtime tuning (rarely overridden) ────────────────
# These have working defaults baked into the code.
# Override only if you know what you're doing.

# LLM provider-specific (override only when using non-default endpoint)
# OPENAI_BASE_URL=  # default: official OpenAI API
# ANTHROPIC_MODEL=claude-haiku-4-5

# Emotion detection backend
# EMOTION_BACKEND=regex  # 'regex' (fast) or 'zenshin' (ML, heavier)

# Avatar / UE5 audio path (only matters when UE5 is connected)
# EDU_UE5_AUDIO=true      # backend sends TTS audio to UE5 instead of browser
# EDU_UE5_AUDIO_MODE=full  # 'full' or 'mute-browser'
# UE5_BROADCAST_DELAY_MS=100
# EDU_TTS_CPS=15
# EDU_AVATAR_PAD_SAFETY_TAIL_MS=400

# Development gates
# EDU_DEV_MODE=false
# EDU_DEV_AVATAR_DEBUG=false
# NEXT_PUBLIC_SKIP_AUTH=false
# NEXT_PUBLIC_UE5_AUDIO=true

# Pydantic Config overrides (use prefix-based env vars; see config/ classes)
# LLM_TEMPERATURE=0.7
# LLM_MAX_NEW_TOKENS=512
# TTS_PROVIDER=edge
# TTS_VOICE_NAME=sk-SK-LukasNeural
