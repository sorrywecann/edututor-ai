# EduTutor.AI — Frontend Environment Variables
# Copy this file to .env.local:   cp .env.example .env.local   (PowerShell: Copy-Item .env.example .env.local)
# All vars here are NEXT_PUBLIC_* (exposed to the browser) — no secrets.

# ── Backend API ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── UE5 MetaHuman avatar (Pixel Streaming) ───────────────────
# REQUIRED for the avatar to appear. Wilbur serves uiless.html on :80.
# The StreamerId query forces the player to subscribe to a specific streamer
# instead of polling listStreamers indefinitely, and it MUST match the ID UE5
# registers on Wilbur — which is "DefaultStreamer" by default (the
# -PixelStreamingID launch arg is NOT reliably honored in UE 5.7, so it falls
# back to the default). Full setup: docs/START_STACK.md.
NEXT_PUBLIC_UE5_STREAM_URL=http://127.0.0.1:80/uiless.html?StreamerId=DefaultStreamer

# ── NextAuth ─────────────────────────────────────────────────
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# ── LiveKit (legacy / optional) ──────────────────────────────
# Vestigial from an earlier transport experiment. The avatar uses Pixel
# Streaming (NEXT_PUBLIC_UE5_STREAM_URL above), NOT LiveKit. Leave unset
# unless you actually run a LiveKit server.
# NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ── Demo user password — matches the on-screen hint at /auth/signin.
# Override in production; the default mirrors the UI hint so the advertised
# demo credentials work out-of-box for grant reviewers.
# DEMO_PASSWORD=edututor2026
