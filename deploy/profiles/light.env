# EduTutor.AI — Tier L (Light) : <10GB RAM, no GPU
# Copy: cp deploy/profiles/light.env .env
# Then add OPENAI_API_KEY. Everything else uses this file's defaults.

# ── LLM: OpenAI cloud (no local VRAM) ──
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── STT: faster-whisper-small (CPU, ~1s) ──
STT_PROVIDER=faster-whisper-small

# ── TTS: Edge TTS cloud (no local load) ──
USE_EDGE_TTS=true
EDGE_TTS_VOICE=sk-SK-LukasNeural
TTS_PROVIDER=edge

# ── RAG: ChromaDB embedded (SQLite, sub-1GB) ──
VECTOR_DB_BACKEND=chroma
RAG_TOP_K_RESULTS=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# ── Emotion: regex (zero load) ──
EMOTION_BACKEND=regex

# ── Avatar: text viseme only (5ms CPU, no GPU needed) ──
UE5_BROADCAST_DELAY_MS=0
