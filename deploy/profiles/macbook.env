# EduTutor.AI — Tier M (MacBook) : 16GB Apple Silicon, MPS GPU
# Copy: cp deploy/profiles/macbook.env .env
# Ollama auto-detect works. For cloud quality, add OPENAI_API_KEY instead.

# ── LLM: Ollama MPS-accelerated ──
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ── STT: mlx-whisper-turbo (MPS, ~500ms) ──
# Auto-detected by hardware onboarding. Explicit override:
# STT_PROVIDER=mlx-whisper-turbo

# ── TTS: Edge TTS cloud + Piper offline fallback ──
USE_EDGE_TTS=true
EDGE_TTS_VOICE=sk-SK-LukasNeural
TTS_PROVIDER=edge
# Offline fallback: set TTS_PROVIDER=piper when no internet.
# Piper model (63MB) auto-downloads on first use.

# ── RAG: ChromaDB, moderate top_k ──
VECTOR_DB_BACKEND=chroma
RAG_TOP_K_RESULTS=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# ── Emotion: regex (fast, good enough for SK) ──
EMOTION_BACKEND=regex

# ── Avatar: text viseme + optional ARKit (MPS) ──
UE5_BROADCAST_DELAY_MS=150
# TTS_ENABLE_VISEME=true (default)

# ── Offline-ready (Ollama + Piper + ChromaDB = no cloud needed) ──
# Before going offline:  brew install ollama && ollama pull qwen2.5:7b
