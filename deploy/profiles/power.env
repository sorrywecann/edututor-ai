# EduTutor.AI — Tier P (Power) : 64+GB RAM, RTX 4090 / A100, CUDA
# Copy: cp deploy/profiles/power.env .env
# Production deployment for school district / regional datacenter.

# ── LLM: vLLM 32B FP16 (best SK quality, batch inference) ──
VLLM_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct
# For native Slovak model:
# CUSTOM_LLM_QWEN3_URL=http://VASTAI_IP:11434/v1
# CUSTOM_LLM_QWEN3_KEY=ollama
# CUSTOM_LLM_QWEN3_MODEL=qwen3-14b-sk

# ── STT: faster-whisper-large-v3 CUDA, best accuracy ──
STT_PROVIDER=faster-whisper-large-v3

# ── TTS: OmniVoice CUDA + voice cloning + Piper fallback ──
TTS_PROVIDER=omnivoice
OMNIVOICE_LANGUAGE=sk
# Fallback to Piper if OmniVoice unavailable:
# TTS_PROVIDER=piper

# ── RAG: Weaviate + OpenAI embeddings ──
VECTOR_DB_BACKEND=weaviate
WEAVIATE_URL=http://localhost:8080
RAG_USE_OPENAI_EMBEDDINGS=true
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K_RESULTS=10
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# ── Emotion: transformers CUDA ──
EMOTION_BACKEND=transformers

# ── Avatar: full 52-channel ARKit CUDA ──
UE5_BROADCAST_DELAY_MS=80
# TTS_ENABLE_VISEME=true (text path as fallback)

# ── LiveKit: voice rooms for concurrency ──
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...

# ── Memory: cross-session episodic memory ──
# Requires ChromaDB persistent path (default: ./data/chroma)

# ── Monitoring: Prometheus metrics endpoint ──
# ENABLE_METRICS=true
