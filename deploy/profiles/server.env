# EduTutor.AI — Tier S (Server) : 32-64GB RAM, RTX 4060 Ti / CPU
# Copy: cp deploy/profiles/server.env .env
# For CUDA Ollama: install nvidia-container-toolkit or bare-metal Ollama.

# ── LLM: Ollama 14B (CUDA) or vLLM 32B-AWQ ──
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b
# For vLLM (better throughput, requires GPU):
# VLLM_URL=http://localhost:8001/v1
# VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# ── STT: faster-whisper-large-v3 (CUDA if available, else CPU) ──
STT_PROVIDER=faster-whisper-large-v3

# ── TTS: Piper local (no cloud dependency) ──
TTS_PROVIDER=piper
USE_EDGE_TTS=false
# Voice cloning optional (CPU-heavy):
# TTS_PROVIDER=omnivoice
# OMNIVOICE_LANGUAGE=sk

# ── RAG: ChromaDB → Weaviate for >10k docs ──
VECTOR_DB_BACKEND=chroma
RAG_TOP_K_RESULTS=7
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
# For Weaviate:
# VECTOR_DB_BACKEND=weaviate
# WEAVIATE_URL=http://localhost:8080

# ── Emotion: transformers (better SK coverage) ──
EMOTION_BACKEND=transformers

# ── Avatar: hybrid (ARKit when audio, text fallback) ──
UE5_BROADCAST_DELAY_MS=150

# ── LiveKit: voice rooms for class/concurrency ──
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
