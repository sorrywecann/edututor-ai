# Tutor service backend — environment variables
# Copy this file: cp tutor-service/.env.example tutor-service/.env
# Add ONE LLM key (OPENAI_API_KEY recommended) — rest has working defaults.

# ─── LLM provider (REQUIRED: at least ONE) ──────────────────────
# OpenAI (recommended for chat-only)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5

# Groq (fast inference, free tier)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama (no API key needed)
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ─── Lipsync (defaults work; override only if needed) ───────────
# LIPSYNC_PROVIDER=hybrid    # 'text' (no audio analysis), 'audio2lipsync', or 'hybrid' (default)

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=true
APP_ENV=development

# ─── Database (defaults to SQLite at data/edututor.db) ──────────
# DATABASE_URL=postgresql://user:pass@localhost/edututor

# ─── See ../.env.example for full reference (TTS, RAG, embeddings, avatar tuning) ───
